# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

SECRET_KEY=
DEBUG=True

# Comma-separated hostnames only (no http://, no ports). 10.0.2.2 is the Android emulator; add your laptop LAN IP for a physical phone.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

DB_NAME=ergospace
DB_USER=ergospace_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated full origins (with scheme), e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Local HTTP: False / Lax.   HTTPS cross-site production: True / None
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# Only if GDAL/GEOS are not auto-detected (e.g. native Windows install without Docker)
# GDAL_LIBRARY_PATH=
# GEOS_LIBRARY_PATH=
